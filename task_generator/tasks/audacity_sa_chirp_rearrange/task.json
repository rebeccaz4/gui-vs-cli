{
  "id": "audacity_sa_chirp_rearrange",
  "app": "audacity",
  "task": "Audacity is open with /home/user/Music/phrase.wav loaded (a 3-second chirp rising from 300 Hz to 3000 Hz). Cut it into three 1-second parts (0-1 s, 1-2 s, 2-3 s) and rearrange them in the order: third part, first part, second part, back to back with no gaps. Then reverse only the part that now comes first. Export as a mono 44100 Hz 16-bit WAV file to /home/user/Music/chirp_edit.wav.",
  "env": {
    "files": [
      {
        "filename": "phrase.wav",
        "sandbox_path": "/home/user/Music/phrase.wav"
      }
    ]
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Music/chirp_edit.wav",
      "key": "exists",
      "expected": true,
      "description": "output exists"
    },
    {
      "command": "check-export-codec /home/user/Music/chirp_edit.wav pcm_s16le",
      "key": "match",
      "expected": true,
      "description": "16-bit PCM WAV"
    },
    {
      "command": "check-export-channels /home/user/Music/chirp_edit.wav 1",
      "key": "match",
      "expected": true,
      "description": "mono"
    },
    {
      "command": "check-export-sample-rate /home/user/Music/chirp_edit.wav 44100",
      "key": "match",
      "expected": true,
      "description": "44100 Hz"
    },
    {
      "command": "check-export-duration-min /home/user/Music/chirp_edit.wav 2.95",
      "key": "match",
      "expected": true,
      "description": "length >= 2.95 s"
    },
    {
      "command": "export-info /home/user/Music/chirp_edit.wav",
      "eval": "float(result['format']['duration']) <= 3.05",
      "description": "length <= 3.05 s"
    },
    {
      "command": "check-export-dominant-freq /home/user/Music/chirp_edit.wav 0.05 0.15 2910 3",
      "key": "match",
      "expected": true,
      "description": "starts with the reversed third part (falling from 3000 Hz)"
    },
    {
      "command": "check-export-dominant-freq /home/user/Music/chirp_edit.wav 1.05 1.15 400 15",
      "key": "match",
      "expected": true,
      "description": "then the first part (rising from 300 Hz)"
    },
    {
      "command": "check-export-dominant-freq /home/user/Music/chirp_edit.wav 2.05 2.15 1310 3",
      "key": "match",
      "expected": true,
      "description": "then the second part (rising from 1200 Hz)"
    }
  ],
  "metadata": {
    "source": "self-authored (update/SELF_AUTHORED_PLAN.md)",
    "replaces": "audacity_gap_reverse_effect",
    "reused_inputs": [
      {
        "from_task": "audacity_gap_reverse_effect",
        "file": "phrase.wav"
      }
    ],
    "gui_plan": [
      "click selection start field",
      "type start time",
      "click selection end field",
      "type end time",
      "Cut (Ctrl+X)",
      "Home",
      "Paste (Ctrl+V)",
      "click selection start field",
      "type start time",
      "click selection end field",
      "type end time",
      "Effect > Reverse",
      "File > Export > Export Audio (Ctrl+Shift+E)",
      "type output path",
      "choose file type",
      "set format options",
      "Save",
      "confirm metadata dialog"
    ],
    "gui_step_estimate": 18
  }
}
