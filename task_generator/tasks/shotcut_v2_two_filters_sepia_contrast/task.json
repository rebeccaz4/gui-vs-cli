    {
      "command": "check-filter-exists /home/user/Documents/color_grade.mlt contrast",
      "key": "exists",
      "expected": true,
      "description": "A contrast filter is present"
    },
    {
      "command": "check-filter-count /home/user/Documents/color_grade.mlt 2",
      "key": "match",
      "expected": true,
      "description": "Project has exactly 2 filters"
    }
  ],
  "metadata": {
