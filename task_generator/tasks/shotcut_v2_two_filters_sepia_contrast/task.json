    {
      "command": "check-clip-exists /home/user/Documents/color_grade.mlt landscape.mp4",
      "key": "exists",
      "expected": true,
      "description": "landscape.mp4 is still referenced"
    },
    {
      "command": "check-filter-exists /home/user/Documents/color_grade.mlt sepia",
      "key": "exists",
      "expected": true,
