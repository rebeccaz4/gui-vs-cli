{
  "id": "musescore3_sa_publishing_credits",
  "app": "musescore3",
  "task": "MuseScore 3 is open with /home/user/Documents/draft_song.mscz (a C major melody on a Piano part). Prepare it for publishing: in the Score Properties set Work Title 'Harbor Lights', Composer 'Ines Moreau' and Copyright '2026 Tidewater Press'; transpose the whole score to F major; and change the part's instrument from Piano to Soprano. Save the score in place and export it as PDF to /home/user/Documents/draft_song.pdf.",
  "env": {
    "files": [
      {
        "filename": "draft_song.mscz",
        "sandbox_path": "/home/user/Documents/draft_song.mscz"
      }
    ]
  },
  "verification": [
    {
      "command": "check-meta-tag /home/user/Documents/draft_song.mscz workTitle Harbor Lights",
      "key": "match",
      "expected": true,
      "description": "workTitle = Harbor Lights"
    },
    {
      "command": "check-meta-tag /home/user/Documents/draft_song.mscz composer Ines Moreau",
      "key": "match",
      "expected": true,
      "description": "composer = Ines Moreau"
    },
    {
      "command": "check-meta-tag /home/user/Documents/draft_song.mscz copyright 2026 Tidewater Press",
      "key": "match",
      "expected": true,
      "description": "copyright = 2026 Tidewater Press"
    },
    {
      "command": "check-key-signature /home/user/Documents/draft_song.mscz -1",
      "key": "match",
      "expected": true,
      "description": "F major (1 flat)"
    },
    {
      "command": "check-note-count /home/user/Documents/draft_song.mscz 16",
      "key": "match",
      "expected": true,
      "description": "notes kept"
    },
    {
      "command": "check-instrument /home/user/Documents/draft_song.mscz Soprano",
      "key": "exists",
      "expected": true,
      "description": "instrument Soprano"
    },
    {
      "command": "check-pdf-exists /home/user/Documents/draft_song.pdf",
      "key": "match",
      "expected": true,
      "description": "PDF exported"
    }
  ],
  "metadata": {
    "source": "self-authored (update/SELF_AUTHORED_PLAN.md)",
    "replaces": "musescore3_multi_meta_publishing",
    "reused_inputs": [
      {
        "from_task": "musescore3_multi_meta_publishing",
        "file": "draft_song.mscz"
      }
    ],
    "gui_plan": [
      "File > Score Properties",
      "type work title",
      "type composer",
      "type copyright",
      "OK",
      "Ctrl+A",
      "Tools > Transpose",
      "choose F major",
      "OK",
      "right-click staff > Staff/Part Properties",
      "Change Instrument",
      "select Soprano",
      "OK",
      "OK",
      "Save",
      "File > Export",
      "choose format",
      "type output path",
      "Save"
    ],
    "gui_step_estimate": 19
  }
}
