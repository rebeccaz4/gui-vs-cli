{
  "id": "cloudcompare_sa_two_slabs",
  "app": "cloudcompare",
  "task": "Open /home/user/Documents/city.ply in CloudCompare (800 points spread over 0..20 on every axis). Extract two slabs: all points with X <= 5, and all points with X >= 15 (any Y and Z). Merge the two slabs into a single cloud (nothing from 5 < X < 15) and save it as an ASCII PLY at /home/user/Documents/city_slabs.ply.",
  "env": {
    "files": [
      {
        "filename": "city.ply",
        "sandbox_path": "/home/user/Documents/city.ply"
      }
    ]
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Documents/city_slabs.ply",
      "key": "exists",
      "expected": true,
      "description": "output exists"
    },
    {
      "command": "check-point-count /home/user/Documents/city_slabs.ply 414",
      "key": "match",
      "expected": true,
      "description": "exactly 414 points"
    },
    {
      "command": "check-bbox-min-extent /home/user/Documents/city_slabs.ply x 19.5",
      "key": "match",
      "expected": true,
      "description": "x extent >= 19.5"
    },
    {
      "command": "check-ply-format /home/user/Documents/city_slabs.ply ascii",
      "key": "match",
      "expected": true,
      "description": "PLY ascii"
    }
  ],
  "metadata": {
    "source": "self-authored (update/SELF_AUTHORED_PLAN.md)",
    "replaces": "cloudcompare_crop_bbox",
    "reused_inputs": [
      {
        "from_task": "cloudcompare_crop_bbox",
        "file": "city.ply"
      }
    ],
    "gui_plan": [
      "select cloud",
      "Tools > Segmentation > Cross Section",
      "type box limit",
      "Export section as new entity",
      "close tool",
      "select cloud",
      "Tools > Segmentation > Cross Section",
      "type box limit",
      "Export section as new entity",
      "close tool",
      "select both slabs",
      "Edit > Merge",
      "File > Save (Ctrl+S)",
      "type output path",
      "choose PLY file type",
      "Save",
      "choose PLY encoding and confirm"
    ],
    "gui_step_estimate": 17
  }
}
