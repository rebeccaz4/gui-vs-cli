{
  "id": "freecad_cw_sketch_012",
  "app": "freecad",
  "task": "Draw a horizontal straight slot centered at the origin with total outside length 30 and width 10. The straight portions are the top and bottom horizontal tangent lines from x = -10 to x = 10 at y = 5 and y = -5. Close the left end with a radius 5 semicircular arc centered at (-10, 0), and close the right end with a radius 5 semicircular arc centered at (10, 0). Do not leave any construction or helper geometry in the final sketch. Save the completed model to /home/user/Unnamed.FCStd.",
  "env": {
    "files": []
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Unnamed.FCStd",
      "key": "exists",
      "expected": true,
      "description": "Output model saved at /home/user/Unnamed.FCStd"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('entity_match_found') is True",
      "description": "CADWorld check: entity_match_found"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('all_relations_passed') is True",
      "description": "CADWorld check: all_relations_passed"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('profile_ok') is True",
      "description": "CADWorld check: profile_ok"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('extra_geometry_ok') is True",
      "description": "CADWorld check: extra_geometry_ok"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('fully_constrained_ok') is True",
      "description": "CADWorld check: fully_constrained_ok"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('solver_status_ok') is True",
      "description": "CADWorld check: solver_status_ok"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('units_ok') is True",
      "description": "CADWorld check: units_ok"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "key": "passed",
      "expected": true,
      "description": "CADWorld all-checks verdict (source benchmark's binary success)"
    }
  ],
  "metadata": {
    "source": "CADWorld (ICLR 2026), https://github.com/Zdong104/CADWORLD",
    "source_task_id": "freecad-sketch-012",
    "source_license": "Apache-2.0",
    "source_domain": "sketch",
    "source_subsets": "60+small",
    "source_evaluator_criteria": [
      "The final sketch must contain exactly two non-construction horizontal line segments and two non-construction circular arcs.",
      "The slot center is at the origin, with arc centers at (-10, 0) and (10, 0), radius 5, total outside length 30, and width 10.",
      "The two end arcs must be opposite semicircles, not full circles or arcs with the wrong direction."
    ],
    "fc019_compat": "yes",
    "fc019_compat_note": ""
  },
  "cli_feasibility": {
    "feasible": "needs-skill-fix",
    "reason": "cli-anything-freecad exposes the needed operations, but its `export render --preset fcstd` writes a synthetic Document.xml (no sketch geometry, generic Part::Feature/PartDesign::Feature types), so CADWorld structure checks fail; see update/validation/README.md section 3"
  }
}
