{
  "id": "audacity_sa_half_amplify",
  "app": "audacity",
  "task": "Audacity is open with /home/user/Music/quiet.wav loaded (a quiet 3-second mono tone). Leave 0-1.5 s unchanged and amplify only 1.5-3.0 s so that the peak of that part is exactly -3.0 dB. Export the result as a mono 44100 Hz 16-bit WAV file to /home/user/Music/quiet_boost.wav.",
  "env": {
    "files": [
      {
        "filename": "quiet.wav",
        "sandbox_path": "/home/user/Music/quiet.wav"
      }
    ]
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Music/quiet_boost.wav",
      "key": "exists",
      "expected": true,
      "description": "output exists"
    },
    {
      "command": "check-export-codec /home/user/Music/quiet_boost.wav pcm_s16le",
      "key": "match",
      "expected": true,
      "description": "16-bit PCM WAV"
    },
    {
      "command": "check-export-channels /home/user/Music/quiet_boost.wav 1",
      "key": "match",
      "expected": true,
      "description": "mono"
    },
    {
      "command": "check-export-sample-rate /home/user/Music/quiet_boost.wav 44100",
      "key": "match",
      "expected": true,
      "description": "44100 Hz"
    },
    {
      "command": "check-export-duration-min /home/user/Music/quiet_boost.wav 2.95",
      "key": "match",
      "expected": true,
      "description": "length >= 2.95 s"
    },
    {
      "command": "export-info /home/user/Music/quiet_boost.wav",
      "eval": "float(result['format']['duration']) <= 3.05",
      "description": "length <= 3.05 s"
    },
    {
      "command": "check-export-region-rms-db /home/user/Music/quiet_boost.wav 0.2 1.3 -24.5 -21.5",
      "key": "match",
      "expected": true,
      "description": "first half unchanged (~-23 dBFS RMS)"
    },
    {
      "command": "check-export-region-rms-db /home/user/Music/quiet_boost.wav 1.7 2.9 -7.5 -4.5",
      "key": "match",
      "expected": true,
      "description": "second half at -3 dB peak (~-6 dBFS RMS)"
    },
    {
      "command": "check-export-peak-db /home/user/Music/quiet_boost.wav -3.5 -2.5",
      "key": "match",
      "expected": true,
      "description": "overall peak -3 dB"
    }
  ],
  "metadata": {
    "source": "self-authored (update/SELF_AUTHORED_PLAN.md)",
    "replaces": "audacity_gap_amplify_export",
    "reused_inputs": [
      {
        "from_task": "audacity_gap_amplify_export",
        "file": "quiet.wav"
      }
    ],
    "gui_plan": [
      "click selection start field",
      "type start time",
      "click selection end field",
      "type end time",
      "Effect > Amplify",
      "type new peak -3 dB",
      "OK",
      "File > Export > Export Audio (Ctrl+Shift+E)",
      "type output path",
      "choose file type",
      "set format options",
      "Save",
      "confirm metadata dialog"
    ],
    "gui_step_estimate": 13
  }
}
