{
  "id": "audacity_sa_cut_splice",
  "app": "audacity",
  "task": "Audacity is open with /home/user/Music/long.wav loaded (a 10-second mono tone). Delete the audio from 3.0 s to 5.0 s (the rest closes the gap, leaving 8 s). Then, in the shortened track, insert 1.0 s of silence at 6.0 s (9 s in total), and raise the pitch of the last second (8.0-9.0 s) by one octave without changing its length. Export the result as a mono 44100 Hz 16-bit WAV file to /home/user/Music/long_edit.wav.",
  "env": {
    "files": [
      {
        "filename": "long.wav",
        "sandbox_path": "/home/user/Music/long.wav"
      }
    ]
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Music/long_edit.wav",
      "key": "exists",
      "expected": true,
      "description": "output exists"
    },
    {
      "command": "check-export-codec /home/user/Music/long_edit.wav pcm_s16le",
      "key": "match",
      "expected": true,
      "description": "16-bit PCM WAV"
    },
    {
      "command": "check-export-channels /home/user/Music/long_edit.wav 1",
      "key": "match",
      "expected": true,
      "description": "mono"
    },
    {
      "command": "check-export-sample-rate /home/user/Music/long_edit.wav 44100",
      "key": "match",
      "expected": true,
      "description": "44100 Hz"
    },
    {
      "command": "check-export-duration-min /home/user/Music/long_edit.wav 8.95",
      "key": "match",
      "expected": true,
      "description": "length >= 8.95 s"
    },
    {
      "command": "export-info /home/user/Music/long_edit.wav",
      "eval": "float(result['format']['duration']) <= 9.05",
      "description": "length <= 9.05 s"
    },
    {
      "command": "check-export-dominant-freq /home/user/Music/long_edit.wav 0.2 5.8 440 3",
      "key": "match",
      "expected": true,
      "description": "0-6 s: the tone"
    },
    {
      "command": "check-export-region-silent /home/user/Music/long_edit.wav 6.05 6.95 -40",
      "key": "match",
      "expected": true,
      "description": "silence inserted at 6.0-7.0 s"
    },
    {
      "command": "check-export-dominant-freq /home/user/Music/long_edit.wav 7.1 7.9 440 3",
      "key": "match",
      "expected": true,
      "description": "7-8 s: unchanged tone"
    },
    {
      "command": "check-export-dominant-freq /home/user/Music/long_edit.wav 8.1 8.9 880 3",
      "key": "match",
      "expected": true,
      "description": "8-9 s: one octave up"
    }
  ],
  "metadata": {
    "source": "self-authored (update/SELF_AUTHORED_PLAN.md)",
    "replaces": "audacity_gap_cut_middle_export",
    "reused_inputs": [
      {
        "from_task": "audacity_gap_cut_middle_export",
        "file": "long.wav"
      }
    ],
    "gui_plan": [
      "click selection start field",
      "type start time",
      "click selection end field",
      "type end time",
      "Delete",
      "click selection start field",
      "type 6.0",
      "Generate > Silence",
      "type 1 s",
      "OK",
      "click selection start field",
      "type start time",
      "click selection end field",
      "type end time",
      "Effect > Change Pitch",
      "type +12",
      "OK",
      "File > Export > Export Audio (Ctrl+Shift+E)",
      "type path",
      "Save",
      "confirm"
    ],
    "gui_step_estimate": 21
  }
}
