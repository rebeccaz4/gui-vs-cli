{
  "id": "freecad_cw_part_013",
  "app": "freecad",
  "task": "Create one Part Design body containing exactly one additive wedge. Use the FreeCAD Additive Wedge primitive parameters X min/max = 0/34 mm, Y min/max = 0/22 mm, Z min/max = 0/16 mm, X2 min/max = 2/8 mm, and Z2 min/max = 2/8 mm. Keep the wedge local axes aligned with the global axes and place its local origin at the global origin, so the outer extents span X = 0 to 34, Y = 0 to 22, and Z = 0 to 16. Keep FreeCAD's default feature names 'Wedge'. Save the completed solid model to /home/user/Unnamed.FCStd.",
  "env": {
    "files": []
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Unnamed.FCStd",
      "key": "exists",
      "expected": true,
      "description": "Output model saved at /home/user/Unnamed.FCStd"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('bbox') is True",
      "description": "CADWorld check: bbox"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('bbox_iou') is True",
      "description": "CADWorld check: bbox_iou"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('required_type_contains') is True",
      "description": "CADWorld check: required_type_contains"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_0') is True",
      "description": "CADWorld check: object_0"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_1') is True",
      "description": "CADWorld check: object_1"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "key": "passed",
      "expected": true,
      "description": "CADWorld all-checks verdict (source benchmark's binary success)"
    }
  ],
  "metadata": {
    "source": "CADWorld (ICLR 2026), https://github.com/Zdong104/CADWORLD",
