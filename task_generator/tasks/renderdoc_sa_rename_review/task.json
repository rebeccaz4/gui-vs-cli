        "from_task": "renderdoc_rename_project_captures",
        "file": "unnamed.rdc"
      },
      {
        "from_task": "renderdoc_rename_project_captures",
        "file": "snapshot_final2.rdc"
      },
      {
        "from_task": "renderdoc_rename_project_captures",
        "file": "backup_old.rdc"
      },
      {
        "from_task": "renderdoc_rename_project_captures",
        "file": "wip_trial.rdc"
