{
  "id": "audacity_sa_octave_canon",
  "app": "audacity",
  "task": "Audacity is open with /home/user/Music/single.wav loaded (a 3-second mono tone). Duplicate the track, lower the copy by one octave (12 semitones) without changing its length, and move the copy so that it starts at 1.0 s. Mix the two tracks by summing them at their original levels (neither is scaled down), and export the mix as a single mono 44100 Hz 16-bit WAV file to /home/user/Music/canon.wav (4.0 s long).",
  "env": {
    "files": [
      {
        "filename": "single.wav",
        "sandbox_path": "/home/user/Music/single.wav"
      }
    ]
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Music/canon.wav",
      "key": "exists",
      "expected": true,
      "description": "output exists"
    },
    {
      "command": "check-export-codec /home/user/Music/canon.wav pcm_s16le",
      "key": "match",
      "expected": true,
      "description": "16-bit PCM WAV"
    },
    {
      "command": "check-export-channels /home/user/Music/canon.wav 1",
      "key": "match",
      "expected": true,
      "description": "mono"
    },
    {
      "command": "check-export-sample-rate /home/user/Music/canon.wav 44100",
      "key": "match",
      "expected": true,
      "description": "44100 Hz"
    },
    {
      "command": "check-export-duration-min /home/user/Music/canon.wav 3.95",
      "key": "match",
      "expected": true,
      "description": "length >= 3.95 s"
    },
    {
      "command": "export-info /home/user/Music/canon.wav",
      "eval": "float(result['format']['duration']) <= 4.05",
      "description": "length <= 4.05 s"
    },
    {
      "command": "check-export-dominant-freq /home/user/Music/canon.wav 0.2 0.8 440 3",
      "key": "match",
      "expected": true,
      "description": "0-1 s: only the original (440 Hz)"
    },
    {
      "command": "check-export-dominant-freq /home/user/Music/canon.wav 3.2 3.8 220 3",
      "key": "match",
      "expected": true,
      "description": "3-4 s: only the copy, one octave lower (220 Hz)"
    },
    {
      "command": "check-export-region-rms-db /home/user/Music/canon.wav 0.2 0.8 -14.5 -11.5",
      "key": "match",
      "expected": true,
      "description": "original level kept"
    }
  ],
  "metadata": {
    "source": "self-authored (update/SELF_AUTHORED_PLAN.md)",
    "replaces": "audacity_gap_duplicate_track",
    "reused_inputs": [
      {
        "from_task": "audacity_gap_duplicate_track",
        "file": "single.wav"
      }
    ],
    "gui_plan": [
      "Select All",
      "Edit > Duplicate (Ctrl+D)",
      "click copy track at 0 s",
      "Generate > Silence",
      "type 1 s",
      "OK",
      "select the copy track",
      "Effect > Change Pitch",
      "type -12 semitones",
      "OK",
      "File > Export > Export Audio (Ctrl+Shift+E)",
      "type output path",
      "choose file type",
      "set format options",
      "Save",
      "confirm metadata dialog"
    ],
    "gui_step_estimate": 16
  }
}
