      "expected": true,
      "description": "Hex display is true"
    },
    {
      "command": "check-setting TextureViewer_ResetRange false",
      "key": "match",
      "expected": true,
      "description": "ResetRange is false"
    }
  ],
  "metadata": {
    "complexity": 4,
