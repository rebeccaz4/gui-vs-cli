{
  "id": "renderdoc_gap_mesh_output_view",
  "app": "renderdoc",
  "task": "Edit UI.config: set Mesh_CurrentStage='VSOut', Mesh_ShowNormals=true, Mesh_Wireframe=true, Mesh_SolidShadeMode='secondary'. Preserve rdocConfigData=1.",
  "env": {
    "files": [
      {
        "filename": "UI.config",
        "sandbox_path": "/home/user/.local/share/qrenderdoc/UI.config"
      }
    ]
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/.local/share/qrenderdoc/UI.config",
      "key": "exists",
      "expected": true,
      "description": "UI.config still exists"
    },
    {
      "command": "check-setting rdocConfigData 1",
      "key": "match",
      "expected": true,
      "description": "rdocConfigData marker preserved"
    },
    {
      "command": "check-setting Mesh_CurrentStage VSOut",
      "key": "match",
      "expected": true,
      "description": "Mesh_CurrentStage VSOut"
    },
    {
      "command": "check-setting Mesh_ShowNormals true",
      "key": "match",
      "expected": true,
      "description": "ShowNormals true"
    },
    {
      "command": "check-setting Mesh_Wireframe true",
      "key": "match",
      "expected": true,
      "description": "Wireframe true"
    },
    {
      "command": "check-setting Mesh_SolidShadeMode secondary",
      "key": "match",
      "expected": true,
      "description": "SolidShadeMode secondary"
    }
  ],
  "metadata": {
    "complexity": 4,
    "data_generatability": 5,
    "verification_determinism": 5,
    "estimated_difficulty": 4
  },
  "cli_feasibility": {
    "feasible": "yes",
    "is_gui_oriented": "yes",
    "translation": "Use Python: import json; data = json.load(open('UI.config')); data['RecentCaptureFiles'] = ['path1.rdc', 'path2.rdc']; json.dump(data, open('UI.config', 'w'), indent=2)",
    "reason": "UI.config is a JSON document. Can use Python's json module to edit it: load, modify specific keys (RecentCaptureFiles, DefaultCaptureSaveDirectory, Font_*, UIStyle, etc.), preserve rdocConfigData marker, save."
  }
}
