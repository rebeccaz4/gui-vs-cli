{
  "id": "cloudcompare_sa_intensity_filter",
  "app": "cloudcompare",
  "task": "Open /home/user/Documents/lidar_intensity.xyz in CloudCompare; it has four columns X Y Z Intensity, and the fourth column must be loaded as a scalar field. Keep only the points with intensity >= 0.6 and save them, together with the intensity scalar field, as a binary little-endian PLY at /home/user/Documents/lidar_bright.ply.",
  "env": {
    "files": [
      {
        "filename": "lidar_intensity.xyz",
        "sandbox_path": "/home/user/Documents/lidar_intensity.xyz"
      }
    ]
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Documents/lidar_bright.ply",
      "key": "exists",
      "expected": true,
      "description": "output exists"
    },
    {
      "command": "check-point-count /home/user/Documents/lidar_bright.ply 234",
      "key": "match",
      "expected": true,
      "description": "exactly 234 points"
    },
    {
      "command": "check-ply-format /home/user/Documents/lidar_bright.ply binary_little_endian",
      "key": "match",
      "expected": true,
      "description": "PLY binary_little_endian"
    },
    {
      "command": "cloud-info /home/user/Documents/lidar_bright.ply",
      "eval": "any(p.startswith('scalar') or 'intensity' in p.lower() for p in result['properties'])",
      "description": "intensity scalar field saved"
    }
  ],
  "metadata": {
    "source": "self-authored (update/SELF_AUTHORED_PLAN.md)",
    "replaces": "cloudcompare_preserve_intensity_export",
    "reused_inputs": [
      {
        "from_task": "cloudcompare_preserve_intensity_export",
        "file": "lidar_intensity.xyz"
      }
    ],
    "gui_plan": [
      "confirm ASCII import (4th column = scalar field)",
      "Edit > Scalar fields > Filter by value",
      "type min 0.6",
      "Export",
      "select entity",
      "File > Save (Ctrl+S)",
      "type output path",
      "choose PLY file type",
      "Save",
      "choose PLY encoding and confirm"
    ],
    "gui_step_estimate": 10
  }
}
