{
  "id": "freecad_set_theme_preference",
  "app": "freecad",
  "task": "Configure FreeCAD so that the style sheet is set to Dark-blue and the auto-save interval is set to 120 seconds (2 minutes). Ensure the changes are saved to FreeCAD's user.cfg (/root/.FreeCAD/user.cfg) while preserving unrelated settings.",
  "env": {
    "files": [
      {
        "filename": "empty.FCStd",
        "sandbox_path": "/home/user/Documents/empty.FCStd"
      }
    ]
  },
  "verification": [
    {
      "command": "check-preference BaseApp/Preferences/MainWindow/StyleSheet Dark-blue.qss",
      "key": "match",
      "expected": true,
      "description": "Style sheet set to Dark-blue"
    },
    {
      "command": "check-preference BaseApp/Preferences/Document/AutoSaveTimeout 2",
      "key": "match",
      "expected": true,
      "description": "Auto-save interval == 2 minutes (120 seconds)"
    }
  ],
  "metadata": {
    "complexity": 3,
    "data_generatability": 5,
    "verification_determinism": 5,
    "estimated_difficulty": 3
  },
  "cli_feasibility": {
    "feasible": "yes",
    "is_gui_oriented": "yes",
    "translation": "Using cli-anything-freecad: preference/theme settings",
    "reason": "CLI-Anything-FreeCAD supports all required operations: preference/theme settings"
  }
}
